# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public project URL and anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used for privileged operations (e.g. admin tasks). Optional for this app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# AI provider (Anthropic Claude) — used by the AI summary feature.
# If unset, the app falls back to a deterministic local summary generator.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the deployed app (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
